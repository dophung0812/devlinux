[Unit]
Description=Monitor Background Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/monitor
Restart=on-failure
RestartSec=5

# Limit restart attempts:
# Maximum 3 starts within 30 seconds.
StartLimitIntervalSec=30
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
